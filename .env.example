# ============================================================
# SUPABASE POSTGRESQL (via Supabase project settings → Database)
# Use the "Session mode" pooler URL for DATABASE_URL (port 5432)
# Use the "Direct connection" URL for DIRECT_URL (for migrations)
# ============================================================
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ============================================================
# JWT
# ============================================================
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-token-secret-min-32-chars"
JWT_REFRESH_EXPIRES_IN="30d"

# ============================================================
# SERVER (Railway sets PORT automatically)
# ============================================================
PORT=5000
NODE_ENV=production
FRONTEND_URL="https://your-app.vercel.app"

# ============================================================
# GOOGLE GEMINI AI
# ============================================================
GEMINI_API_KEY="your-gemini-api-key-from-aistudio.google.com"

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
